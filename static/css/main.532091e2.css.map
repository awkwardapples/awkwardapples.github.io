.home {
  height: calc(100vh - 60px);
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #1f1c2c, #928dab);
  position: relative;
  overflow: hidden;
}

.hero-card {
  background: rgba(255,255,255,0.95);
  padding: 2rem;
  border-radius: 15px;
  text-align: center;
  box-shadow: 0 10px 25px rgba(0,0,0,0.3);
  transition: transform 0.3s ease;
}

.hero-card:hover {
  transform: scale(1.03);
}

.hero-image {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  object-fit: cover;
  border: 3px solid #00ffea;
  margin-bottom: 1rem;
}

.hero-card h1 {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

.hero-card h2 {
  font-size: 1.5rem;
  color: #555;
  margin-bottom: 1rem;
}

.hero-card p {
  font-size: 1rem;
  line-height: 1.5;
  color: #333;
}

.cursor {
  width: 25px;
  height: 25px;
  background: rgba(0,255,234,0.6);
  border-radius: 50%;
  position: fixed;
  pointer-events: none;
  transform: translate(-50%, -50%);
  mix-blend-mode: difference;
  z-index: 999;
  transition: width 0.2s ease, height 0.2s ease;
}
