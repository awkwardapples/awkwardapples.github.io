.home-container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 20px;
}

.hero-card {
  background: rgba(15, 15, 25, 0.95);
  border: 1px solid rgba(107, 76, 129, 0.4);
  border-radius: 16px;
  padding: 3rem;
  margin-bottom: 3rem;
  box-shadow: 
    0 12px 40px rgba(0, 0, 0, 0.3),
    0 0 0 1px rgba(107, 76, 129, 0.2);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  transition: all 0.3s ease;
}

.hero-card:hover {
  transform: translateY(-2px);
  box-shadow: 
    0 16px 50px rgba(0, 0, 0, 0.4),
    0 0 0 1px rgba(107, 76, 129, 0.4);
}

.hero-content {
  display: flex;
  align-items: center;
  gap: 3rem;
}

.hero-text {
  flex: 1;
}

.hero-text h1 {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: #f0f0f0;
  text-shadow: 0 2px 4px rgba(107, 76, 129, 0.3);
}

.hero-subtitle {
  font-size: 1.3rem;
  font-weight: 500;
  color: #b999d1;
  margin-bottom: 1.5rem;
}

.hero-description {
  font-size: 1.1rem;
  line-height: 1.6;
  color: #d0d0d0;
  margin-bottom: 1.5rem;
}

.education {
  font-size: 1.1rem;
  font-weight: 500;
  color: #b999d1;
  margin-bottom: 2rem;
  padding: 0.5rem 0;
}

.hero-links {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.cta-button {
  display: inline-block;
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  font-size: 16px;
  transition: all 0.3s ease;
  cursor: pointer;
  background: linear-gradient(135deg, #6b4c81, #9d7bb8);
  color: #ffffff;
  box-shadow: 0 4px 16px rgba(107, 76, 129, 0.4);
}

.cta-button:hover {
  background: linear-gradient(135deg, #7d5a95, #b199d1);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(107, 76, 129, 0.6);
}

.hero-image {
  flex-shrink: 0;
}

.profile-image {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  object-fit: cover;
  border: 3px solid rgba(107, 76, 129, 0.4);
  box-shadow: 
    0 8px 32px rgba(0, 0, 0, 0.3),
    inset 0 2px 4px rgba(185, 153, 209, 0.2);
  transition: all 0.3s ease;
}

.profile-image:hover {
  transform: scale(1.05);
  box-shadow: 
    0 12px 40px rgba(0, 0, 0, 0.4),
    inset 0 2px 4px rgba(185, 153, 209, 0.3);
}

/* Mobile responsiveness */
@media (max-width: 768px) {
  .home-container {
    padding: 16px;
  }
  
  .hero-card {
    padding: 2rem;
    margin-bottom: 2rem;
  }
  
  .hero-content {
    flex-direction: column;
    text-align: center;
    gap: 2rem;
  }
  
  .hero-text h1 {
    font-size: 2.2rem;
  }
  
  .hero-subtitle {
    font-size: 1.1rem;
  }
  
  .hero-description {
    font-size: 1rem;
  }
  
  .profile-image {
    width: 140px;
    height: 140px;
  }
  
  .cta-button {
    padding: 10px 20px;
    font-size: 15px;
  }
}.home-container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 20px;
}

.hero-card {
  background: rgba(15, 15, 25, 0.95);
  border: 1px solid rgba(107, 76, 129, 0.4);
  border-radius: 16px;
  padding: 3rem;
  margin-bottom: 3rem;
  box-shadow: 
    0 12px 40px rgba(0, 0, 0, 0.3),
    0 0 0 1px rgba(107, 76, 129, 0.2);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  transition: all 0.3s ease;
}

.hero-card:hover {
  transform: translateY(-2px);
  box-shadow: 
    0 16px 50px rgba(0, 0, 0, 0.4),
    0 0 0 1px rgba(107, 76, 129, 0.4);
}

.hero-content {
  display: flex;
  align-items: center;
  gap: 3rem;
}

.hero-text {
  flex: 1;
}

.hero-text h1 {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: #f0f0f0;
  text-shadow: 0 2px 4px rgba(107, 76, 129, 0.3);
}

.hero-subtitle {
  font-size: 1.3rem;
  font-weight: 500;
  color: #b999d1;
  margin-bottom: 1.5rem;
}

.hero-description {
  font-size: 1.1rem;
  line-height: 1.6;
  color: #d0d0d0;
  margin-bottom: 2rem;
}

.hero-links {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.cta-button {
  display: inline-block;
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  font-size: 16px;
  transition: all 0.3s ease;
  cursor: pointer;
}

.cta-button:not(.secondary) {
  background: linear-gradient(135deg, #6b4c81, #9d7bb8);
  color: #ffffff;
  box-shadow: 0 4px 16px rgba(107, 76, 129, 0.4);
}

.cta-button:not(.secondary):hover {
  background: linear-gradient(135deg, #7d5a95, #b199d1);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(107, 76, 129, 0.6);
}

.cta-button.secondary {
  background: transparent;
  color: #b999d1;
  border: 2px solid rgba(107, 76, 129, 0.6);
}

.cta-button.secondary:hover {
  background: rgba(107, 76, 129, 0.2);
  border-color: #b999d1;
  color: #d1b8e6;
  transform: translateY(-2px);
}

.hero-image {
  flex-shrink: 0;
}

.profile-placeholder {
  width: 180px;
  height: 180px;
  background: linear-gradient(135deg, #2d1b36, #4a2b5c);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rem;
  font-weight: 700;
  color: #b999d1;
  border: 3px solid rgba(107, 76, 129, 0.4);
  box-shadow: 
    0 8px 32px rgba(0, 0, 0, 0.3),
    inset 0 2px 4px rgba(185, 153, 209, 0.2);
  transition: all 0.3s ease;
}

.profile-placeholder:hover {
  transform: scale(1.05);
  box-shadow: 
    0 12px 40px rgba(0, 0, 0, 0.4),
    inset 0 2px 4px rgba(185, 153, 209, 0.3);
}

.features-section {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

.feature-card {
  background: rgba(15, 15, 25, 0.9);
  border: 1px solid rgba(107, 76, 129, 0.3);
  border-radius: 12px;
  padding: 2rem;
  text-align: center;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}

.feature-card:hover {
  transform: translateY(-4px);
  border-color: rgba(107, 76, 129, 0.5);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.feature-card h3 {
  font-size: 1.4rem;
  font-weight: 600;
  color: #f0f0f0;
  margin-bottom: 1rem;
}

.feature-card p {
  color: #c0c0c0;
  line-height: 1.5;
  font-size: 1rem;
}

/* Mobile responsiveness */
@media (max-width: 768px) {
  .home-container {
    padding: 16px;
  }
  
  .hero-card {
    padding: 2rem;
    margin-bottom: 2rem;
  }
  
  .hero-content {
    flex-direction: column;
    text-align: center;
    gap: 2rem;
  }
  
  .hero-text h1 {
    font-size: 2.2rem;
  }
  
  .hero-subtitle {
    font-size: 1.1rem;
  }
  
  .hero-description {
    font-size: 1rem;
  }
  
  .profile-placeholder {
    width: 140px;
    height: 140px;
    font-size: 2.5rem;
  }
  
  .features-section {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .feature-card {
    padding: 1.5rem;
  }
  
  .cta-button {
    padding: 10px 20px;
    font-size: 15px;
  }
}