.blog-container {
  max-width: 900px;
  margin: 0 auto;
  padding: 20px;
}

.blog-container h2 {
  font-size: 32px;
  font-weight: 700;
  margin-bottom: 30px;
  color: #f0f0f0;
  text-align: center;
  text-shadow: 0 2px 4px rgba(107, 76, 129, 0.3);
}

/* Dark theme overrides for any remaining light elements */
.blog-title {
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 20px;
  color: #f0f0f0;
}

.post {
  border: 1px solid rgba(107, 76, 129, 0.3);
  border-radius: 8px;
  padding: 15px;
  margin-bottom: 20px;
  background: rgba(15, 15, 25, 0.8);
  color: #d0d0d0;
}

.post .username {
  font-weight: bold;
  font-size: 18px;
  color: #f0f0f0;
  margin-bottom: 5px;
}

.post .timestamp {
  font-size: 14px;
  color: #a0a0a0;
}

.post .message {
  font-size: 16px;
  color: #d0d0d0;
  line-height: 1.5;
}