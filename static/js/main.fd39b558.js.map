import React from 'react';
import './Home.css';

const Home = () => {
  return (
    <div className="home-container">
      <div className="hero-card">
        <div className="hero-content">
          <div className="hero-text">
            <h1>Josh Lennon</h1>
            <p className="hero-subtitle">Computer Science & Artificial Intelligence Graduate</p>
            <p className="hero-description">
              Born Near London, Studied in Manchester. Explore some of my projects, research papers, and various of my technical works here.
            </p>
            <p className="education">
              BSc Artificial Intelligence - University of Manchester
            </p>
            <div className="hero-links">
              <a href="#/blog" className="cta-button">View My Work</a>
            </div>
          </div>
          <div className="hero-image">
            <img src="/66ECDF03-5985-4167-8E9F-31935E3EFD29.jpg" alt="Josh Lennon" className="profile-image" />
          </div>
        </div>
      </div>
    </div>
  );
};

export default Home;