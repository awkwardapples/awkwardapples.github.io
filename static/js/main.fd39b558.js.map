// Blog.js
import React from 'react';
import Post from '../Post';
import './Blog.css';

const Blog = () => {
  const posts = [
    {
      username: 'Understanding Deep Learning Paper',
      message: 'A mathematical paper I wrote delving into the theoretical foundations of neural networks, machine learning, deep learning scalability, and optimisation algorithms. The paper provides a simple neural network topology and builds on principles established in a simple example to expand understanding to deep learning. The paper aims to provide a good entry point for academics looking to gain a broader technical understanding of machine learning techniques.',
      timestamp: '2025-09-17 12:00 PM',
      pdfUrl: '/Understanding Deep Learning - Josh Lennon.pdf',
    },
    {
      username: 'Extracting Magnetic information from image data - Graduate Dissertation',
      message: 'I achieved a 1st class grade in my final year project at the university of Manchester. The project involved computer vision and image processing. This project develops an automated image processing pipeline for Kerr Microscopy to improve image analysis and extraction of magnetic data by producing a web application interface to enhance research.',
      timestamp: '2025-08-11 20:24 PM',
      pdfUrl: '/MAGNETIC IMAGE DATA PROJECT.pdf',
    },
    {
      username: 'Testing for Neural Network Project',
      message: 'Check out this neural network video and the PDF below. I created a tool demonstrating the fundamental principles of neural network mathematical computation theory. This project was programmed without the use of any libraries and acts as its own library framework from scratch for creating an object oriented platform for creating and testing neural network structures.',
      timestamp: '2023-10-08 20:54 PM',
      pdfUrl: '/Iris identifier (2024_11_28 01_50_27 UTC).pdf',
    },
    {
      username: 'Neural Network Visual Basic Project Testing Playlist',
      message: 'Independently researched neural network machine learning tool demonstrated (using the Iris data set).',
      timestamp: '2023-10-08 11:30 AM',
      videoId: 'wWAGaOdlyMw',
    },
  ];

  return (
    <div className="blog-container">
      <h2>Latest Posts</h2>
      {posts.map((post, index) => (
        <Post
          key={index}
          username={post.username}
          message={post.message}
          timestamp={post.timestamp}
          videoId={post.videoId}
          pdfUrl={post.pdfUrl}
        />
      ))}
    </div>
  );
};

export default Blog;
